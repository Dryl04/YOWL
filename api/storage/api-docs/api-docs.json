                "description": "Crée un nouvel utilisateur après validation des données et vérification de l'âge (13-35 ans).",
                "operationId": "73d4cf26054aed943dde45c888b2e646",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "dateOfBirth",
                                    "telephone"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "motdepasse123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "motdepasse123"
                                    },
                                    "dateOfBirth": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2000-01-15"
                                    },
                                    "work": {
                                        "type": "string",
                                        "example": "Développeur web"
                                    },
                                    "photo": {
                                        "type": "string",
                                        "example": "https://example.com/photo.jpg"
                                    },
                                    "telephone": {
                                        "type": "string",
                                        "example": "+22991234567"
                                    },
                                    "bio": {
                                        "type": "string",
                                        "example": "Je suis un jeune entrepreneur béninois."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Utilisateur créé avec succès",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Utilisateur créé avec succès"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
